# tgflow — 环境变量样例
# 复制为 .env 后填写；.env 不进 git

# 框架根目录（运行期数据/插件搜索路径）
TGFLOW_HOME=/app

# Telegram 账号（tg_sync 迁移后需要）
TG_API_ID=
TG_API_HASH=
# 用户号 Session（Telethon StringSession）
TG_SESSION_STRING=
# 转发 Bot token
NOTIFY_BOT_TOKEN=
NOTIFY_CHAT_ID=

# 代理（宿主机 mihomo）
PROXY_ENABLED=true
PROXY_HOST=127.0.0.1
PROXY_PORT=7891
PROXY_TYPE=socks5

# 品牌链接（官网注入插件）
BRAND_SITE_URL=https://vault.aaaaaaaa.host/
BRAND_SITE_LABEL=官网

# 通知
NOTIFY_ENABLED=false
